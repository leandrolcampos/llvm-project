// Generate the degree-10 Estrin polynomial for expf_float_estrin.h with N = 1.
// N = 1 selects the implementation without a stored lookup table.
// Run with: sollya libc/utils/mathtools/expf_gpu/estrin/N_1.sollya

prec = 165!;

pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);

d = [-log(2) / 2; log(2) / 2];

// Fix the constant, linear, and quadratic coefficients. Degrees 3 through 5
// use 49-bit float-float coefficients; degrees 6 through 10 use F32.
// Absolute-error optimization was selected by the adaptive search. Relative
// error optimization, other degrees/precisions, partial minimax with fixed
// Taylor/minimax neighbors, and perturbed intervals were also explored.
pf = fpminimax(f, [|3, ..., 10|],
               [|49, 49, 49, 24, 24, 24, 24, 24|],
               d, absolute, floating, 1 + x + x^2/2);

// Evaluate Q as A + x^2*B + x^4*T, where
// A = c3 + x*c4, B = c5 + x*c6,
// T = (c7 + x*c8) + x^2*(c9 + x*c10).
// Then P = 1 + x + x^2*(1/2 + x*Q).
// exp_eval uses 41 F32 operations (one per FMA), including compensation and
// reconstruction. The square residual is accumulated before the polynomial
// low word in the final compensated FMA; this ordering is part of the tested
// evaluation and is required by the exhaustive RN-even validation.
pff = 1 + x;
display = hexadecimal!;
print("Coefficients {lo, hi}, degrees 2 through 10:");
for i from 2 to 10 do {
  ch = round(coeff(pf, i), SG, RN);
  cl = round(coeff(pf, i) - ch, SG, RN);
  pff = pff + (ch + cl) * x ^ i;
  print("{", cl, ",", ch, "}");
};

print("\nPolynomial:", pff);

// Approximation errors on d, excluding errors from floating-point polynomial
// evaluation and range reduction.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient splitting error (estimate):",
      dirtyinfnorm(pff - pf, d));

quit;
