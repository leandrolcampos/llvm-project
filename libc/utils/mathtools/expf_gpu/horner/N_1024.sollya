// Generate the degree-3 Horner polynomial for expf_float_horner.h with N = 1024.
// N is the number of lookup table entries.
// Run with: sollya libc/utils/mathtools/expf_gpu/horner/N_1024.sollya

prec = 256!;

pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);
d = [-log(2) / 2048; log(2) / 2048];

// The quadratic float-float coefficient uses 48 = 2 * 24 bits.
// Fix the constant and linear coefficients to 1; the cubic coefficient uses
// float precision.
pf = fpminimax(f, [|2, 3|], [|48, SG|], d, relative, floating, 1 + x);

display = hexadecimal!;
c2_hi = round(coeff(pf, 2), SG, RN);
c2_lo = round(coeff(pf, 2) - c2_hi, SG, RN);
c3 = round(coeff(pf, 3), SG, RN);
print("FloatFloat coefficient, degree 2, in {lo, hi} order:");
print("{", c2_lo, ",", c2_hi, "}");
print("\nFloat coefficient, degree 3:");
print(c3);

pff = 1 + x + (c2_hi + c2_lo) * x^2 + c3 * x^3;
print("\nPolynomial:", pff);

// Approximation errors on d, excluding errors from floating-point polynomial
// evaluation and range reduction.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient rounding error (estimate):",
      dirtyinfnorm(pff - pf, d));
