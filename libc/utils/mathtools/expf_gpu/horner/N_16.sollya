// Generate the degree-6 Horner polynomial for expf_float_horner.h with N = 16.
// N is the number of lookup table entries.
// Run with: sollya libc/utils/mathtools/expf_gpu/horner/N_16.sollya

prec = 165!;

pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);

d = [-log(2) / 32; log(2) / 32];

// The cubic float-float coefficient uses 49 = 2 * 24 + 1 bits.
// Degrees 2, 4, 5, and 6 use float coefficients.
// Fix the quadratic coefficient to 1/2.
// The quartic coefficient is also fixed; its value and the cubic adjustment
// below were selected during an adaptive search.
pf = fpminimax(f, [|3, 5, 6|],
               [|49, 24, 24|],
               d, relative, floating,
               1 + x + x^2/2 + 0x1.55554cp-5 * x^4);

// Apply the selected -2^-34 adjustment to the cubic coefficient for the
// reconstruction using table_entry.lo * exp_r_hi.
pf = pf - 0x1p-34 * x^3;

pff = 1 + x;
display = hexadecimal!;
print("Coefficients {lo, hi}, degrees 2 through 6:");
for i from 2 to 6 do {
  ch = round(coeff(pf, i), SG, RN);
  cl = round(coeff(pf, i) - ch, SG, RN);
  pff = pff + (ch + cl) * x ^ i;
  print("{", cl, ",", ch, "}");
};

print("\nPolynomial:", pff);

// Approximation errors on d, excluding errors from floating-point polynomial
// evaluation and range reduction.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient splitting error (estimate):",
      dirtyinfnorm(pff - pf, d));
