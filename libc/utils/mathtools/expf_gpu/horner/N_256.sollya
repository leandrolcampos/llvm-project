// Generate the degree-8 Horner polynomial for expf_float_horner.h with N = 256.
// N is the number of lookup table entries.
// Run with: sollya libc/utils/mathtools/expf_gpu/horner/N_256.sollya

prec = 512!;

// Format estimates for display only.
pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);

d = [-log(2) / 512; log(2) / 512];

// The float tail and quadratic adjustment were selected by a counterexample-
// guided search and exhaustive testing of the complete implementation with
// N=8's reconstruction. They compensate for lookup and reconstruction errors.
// Generate the quadratic at 53 bits, then split it into two floats.
tail_poly =
    0x1.555f8cp-3 * x^3
    +0x1.1ef04ap-5 * x^4
    -0x1.00dad6p+5 * x^5
    +0x1.3312bap+14 * x^6
    +0x1.6f1af2p+23 * x^7
    -0x1.ef4132p+32 * x^8;
p_mixed = fpminimax(f, [|2|], [|53|], d, relative, floating, 1 + x + tail_poly);
p_mixed = p_mixed + (-0x1.b1298p-37) * x^2;

pff = 1 + x;
display = hexadecimal!;
print("Coefficients {lo, hi}, degrees 2 through 8:");
for i from 2 to 8 do {
  ch = round(coeff(p_mixed, i), SG, RN);
  cl = round(coeff(p_mixed, i) - ch, SG, RN);
  pff = pff + (ch + cl) * x ^ i;
  print("{", cl, ",", ch, "}");
};

print("\nPolynomial:", pff);

// Approximation errors on d, excluding evaluation and reduction errors.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient splitting error (estimate):",
      dirtyinfnorm(pff - p_mixed, d));
