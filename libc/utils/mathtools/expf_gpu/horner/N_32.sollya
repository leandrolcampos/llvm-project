// Generate the degree-5 Horner polynomial for expf_float_horner.h with N = 32.
// N is the number of lookup table entries.
// Run with: sollya libc/utils/mathtools/expf_gpu/horner/N_32.sollya

prec = 165!;

pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);

// The nominal reduction interval is widened by 20% on the positive side.
// The factor 1.2 was selected during an adaptive search that included scaling
// either endpoint by 0.9, 0.95, 0.99, 1.001, 1.01, 1.05, 1.1, and 1.2.
d = [-log(2) / 64; 1.2 * log(2) / 64];

// The quadratic float-float coefficient uses 49 = 2 * 24 + 1 bits.
// Degrees 3 through 5 use float coefficients.
// The quadratic adjustment below was selected during an adaptive search.
pf = fpminimax(f, [|2, ..., 5|],
               [|49, 24, 24, 24|],
               d, absolute, floating, 1 + x);

// Apply the selected +2^-36 adjustment to the quadratic coefficient for the
// reconstruction using table_entry.lo * exp_r_hi.
pf = pf + 0x1p-36 * x^2;

pff = 1 + x;
display = hexadecimal!;
print("Coefficients {lo, hi}, degrees 2 through 5:");
for i from 2 to 5 do {
  ch = round(coeff(pf, i), SG, RN);
  cl = round(coeff(pf, i) - ch, SG, RN);
  pff = pff + (ch + cl) * x ^ i;
  print("{", cl, ",", ch, "}");
};

print("\nPolynomial:", pff);

// Approximation errors on d, excluding errors from floating-point polynomial
// evaluation and range reduction.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient splitting error (estimate):",
      dirtyinfnorm(pff - pf, d));
