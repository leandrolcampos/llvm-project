// Generate the degree-4 Horner polynomial for expf_float_horner.h with N = 512.
// N is the number of lookup table entries.
// Run with: sollya libc/utils/mathtools/expf_gpu/horner/N_512.sollya

prec = 256!;

// Format estimates for display only.
pretty = proc(u) {
  return ~(floor(u * 1000) / 1000);
};

f = exp(x);
d = [-log(2) / 1024; log(2) / 1024];

// The small linear-coefficient bias was selected by exhaustive testing of
// cr_expf_rn, using the downward-rounded high table words and N = 8's
// reconstruction. Keep the quadratic and quartic coefficients fixed and
// optimize the float cubic coefficient for this bias.
c1 = 1 - 19 * 0x1p-45;
c2 = 0.5;
c4 = round(1 / 24, SG, RN);
p_mixed = fpminimax(f, [|3|], [|SG|], d, relative, floating,
                   1 + c1 * x + c2 * x^2 + c4 * x^4);

display = hexadecimal!;
c1_hi = round(c1, SG, RN);
c1_lo = round(c1 - c1_hi, SG, RN);
print("FloatFloat coefficient, degree 1, in {lo, hi} order:");
print("{", c1_lo, ",", c1_hi, "}");

pff = 1 + (c1_hi + c1_lo) * x;
print("\nFloat coefficients, degrees 2 through 4:");
for i from 2 to 4 do {
  ch = round(coeff(p_mixed, i), SG, RN);
  pff = pff + ch * x^i;
  print(ch);
};

print("\nPolynomial:", pff);

// Approximation errors on d, excluding evaluation and reduction errors.
display = decimal!;
err_rel = dirtyinfnorm((pff - f) / f, d);
print("\nRelative error (estimate):", err_rel);
print("Relative error in bits (estimate):", pretty(-log2(err_rel)));
print("Relative error (certified enclosure):",
      supnorm(pff, f, d, relative, 0x1p-20));
print("Absolute error (estimate):", dirtyinfnorm(pff - f, d));
print("Coefficient rounding error (estimate):",
      dirtyinfnorm(pff - p_mixed, d));
